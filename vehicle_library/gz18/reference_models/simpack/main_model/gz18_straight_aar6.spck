body.m (                            $B_vehicle                    ) = $_Mc                    ! Mass of the Body
body.mp (                           $B_vehicle                    ) = 0                       ! 0=manual; 1=auto (based on geometry); 2=mass manual, CG & Inertia auto
body.cg.pos (             3 ,       $B_vehicle                    ) = { -$_hc }               ! Center of gravity
body.I.tens (             1 ,   1 , $B_vehicle                    ) = $_Icx                   ! Moments of inertia
body.I.tens (             2 ,   2 , $B_vehicle                    ) = $_Icy                   ! Moments of inertia
body.I.tens (             3 ,   3 , $B_vehicle                    ) = $_Icz                   ! Moments of inertia
body.I.kind (                       $B_vehicle                    ) = -1                      ! Kind of I-tensor specification: -1=wrt CG; 0=wrt BRF; 1=wrt Marker
