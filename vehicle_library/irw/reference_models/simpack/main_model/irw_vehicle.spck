slv.rt.enable (                     $SLV_SolverSettings           ) = 1                       ! Enable realtime simulation
slv.rt.stepsize (                   $SLV_SolverSettings           ) = 1.00000000000000002E-03 ! Communication Stepsize (0 = each integrator step)
slv.rt.animation.enable (           $SLV_SolverSettings           ) = 0                       ! Enable realtime animation
slv.rt.log.rate (                   $SLV_SolverSettings           ) = 1                       ! Realtime logger rate (0 = no logging, 1 = every frame, ...)
