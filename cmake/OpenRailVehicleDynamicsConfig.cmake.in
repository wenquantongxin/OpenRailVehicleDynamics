@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Eigen3 3.4 CONFIG)
find_dependency(fmt 9.1.0 CONFIG NO_SYSTEM_ENVIRONMENT_PATH)
find_dependency(SUNDIALS 7.7.0 EXACT CONFIG
    COMPONENTS cvode nvecserial sunmatrixdense sunlinsoldense core)

include("${CMAKE_CURRENT_LIST_DIR}/OpenRailVehicleDynamicsTargets.cmake")
check_required_components(OpenRailVehicleDynamics)
