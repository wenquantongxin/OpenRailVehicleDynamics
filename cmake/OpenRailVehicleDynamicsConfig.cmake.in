@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/OrvdPlatformToolchainBootstrap.cmake")

orvd_require_supported_macos_target()

find_dependency(Eigen3 3.4.0 EXACT CONFIG)
find_dependency(fmt 9.1.0 EXACT CONFIG NO_SYSTEM_ENVIRONMENT_PATH)
find_dependency(SUNDIALS 7.7.0 EXACT CONFIG
    COMPONENTS cvode nvecserial sunmatrixdense sunlinsoldense core)
if(DEFINED CMAKE_PREFIX_PATH)
    set(_orvd_cmake_prefix_path_was_defined TRUE)
else()
    set(_orvd_cmake_prefix_path_was_defined FALSE)
endif()
set(_orvd_saved_cmake_prefix_path "${CMAKE_PREFIX_PATH}")
orvd_resolve_appleclang_openmp_prefix(_orvd_appleclang_openmp_prefix)
if(NOT "${_orvd_appleclang_openmp_prefix}" STREQUAL "")
    list(APPEND CMAKE_PREFIX_PATH "${_orvd_appleclang_openmp_prefix}")
    list(REMOVE_DUPLICATES CMAKE_PREFIX_PATH)
endif()
find_package(OpenMP QUIET COMPONENTS CXX)
if(_orvd_cmake_prefix_path_was_defined)
    set(CMAKE_PREFIX_PATH "${_orvd_saved_cmake_prefix_path}")
else()
    unset(CMAKE_PREFIX_PATH)
endif()
unset(_orvd_appleclang_openmp_prefix)
unset(_orvd_saved_cmake_prefix_path)
unset(_orvd_cmake_prefix_path_was_defined)
if(NOT OpenMP_FOUND)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OpenRailVehicleDynamicsTargets.cmake")

foreach(_orvd_component IN LISTS OpenRailVehicleDynamics_FIND_COMPONENTS)
    if(NOT _orvd_component STREQUAL "simpack_realtime")
        set(OpenRailVehicleDynamics_${_orvd_component}_FOUND FALSE)
    endif()
endforeach()

if("simpack_realtime" IN_LIST OpenRailVehicleDynamics_FIND_COMPONENTS)
    set(OpenRailVehicleDynamics_SIMPACK_ROOT "" CACHE PATH
        "SIMPACK root for the optional ORVD Realtime component")
    set(_orvd_simpack_realtime_header
        "${OpenRailVehicleDynamics_SIMPACK_ROOT}/run/realtime/spck_rt.h")
    set(_orvd_simpack_realtime_library
        "${OpenRailVehicleDynamics_SIMPACK_ROOT}/run/realtime/linux64/libspck_rt.a")
    if(@ORVD_SIMPACK_REALTIME_COMPONENT_BUILT@
       AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/OpenRailVehicleDynamicsSimpackRealtimeTargets.cmake"
       AND EXISTS "${_orvd_simpack_realtime_header}"
       AND EXISTS "${_orvd_simpack_realtime_library}")
        find_package(Threads QUIET)
        if(Threads_FOUND)
            if(NOT TARGET SIMPACKRealtime::spck_rt)
                add_library(SIMPACKRealtime::spck_rt STATIC IMPORTED)
                set_target_properties(SIMPACKRealtime::spck_rt PROPERTIES
                    IMPORTED_LOCATION "${_orvd_simpack_realtime_library}"
                    INTERFACE_INCLUDE_DIRECTORIES
                        "${OpenRailVehicleDynamics_SIMPACK_ROOT}/run/realtime")
            endif()
            include(
                "${CMAKE_CURRENT_LIST_DIR}/OpenRailVehicleDynamicsSimpackRealtimeTargets.cmake")
            set(OpenRailVehicleDynamics_simpack_realtime_FOUND TRUE)
        else()
            set(OpenRailVehicleDynamics_simpack_realtime_FOUND FALSE)
        endif()
    else()
        set(OpenRailVehicleDynamics_simpack_realtime_FOUND FALSE)
    endif()
endif()

check_required_components(OpenRailVehicleDynamics)
