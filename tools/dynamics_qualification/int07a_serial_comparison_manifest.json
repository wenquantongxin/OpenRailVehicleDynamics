    "reference_band_candidate_distance_rule": "maximum_distance_to_either_reference",
    "kinematic_entity_group": "all_contact_carriers",
    "physical_metric_scope": "full_qualification_clock_including_both_endpoints",
    "carrier_error_reduction_rule": "same_time_absolute_error_global_max_over_all_contact_carriers_and_full_clock",
    "contact_interface_set_rule": "exact_identical_named_interface_set",
    "contact_event_detection_rule": "sampled_patch_count_on_off;event_time_is_first_sample_of_new_state;include_t0_initial_state",
    "contact_event_matching_rule": "fail_closed;initial_on_off_vector_must_match;per_interface_and_polarity_event_counts_must_match;unmatched_event_fails;match_by_interface_polarity_and_ordinal;single_off_sample_duration_is_one_tick;terminal_off_interval_is_right_censored",
