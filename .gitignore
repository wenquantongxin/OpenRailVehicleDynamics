# Build
/build/
/out/
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
compile_commands.json

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake

# Local build configuration. Points build trees at this machine's external volume,
# so it is per-machine by definition and must not be tracked.
CMakeUserPresets.json

# IDE / editor
.vscode/
.idea/
.cache/
*.swp

# Results / scratch
/results/
/logs/
/tmp/
__pycache__/
*.py[cod]

# Numeric archives are never committed: no golden vectors, snapshots or hashes
# take part in acceptance.
*.npz

# Binary artifacts; retain PNGs linked directly from README files.
*.bin
*.png
!/apps/scene_viewer_web/screenshots/irw_r300_overview.png
