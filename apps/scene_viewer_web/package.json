{
  "name": "orvd-scene-viewer-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check-record": "node --experimental-strip-types scripts/check_record.ts",
    "test": "node --experimental-strip-types --test tests/playback_controller.test.ts tests/pose_interpolation.test.ts tests/vehicle_display_bindings.test.ts tests/vehicle_readout_model.test.ts tests/track_model.test.ts tests/subtitle.test.ts",
    "check-interpolation": "node --experimental-strip-types scripts/check_interpolation.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
